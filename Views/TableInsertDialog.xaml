<Window x:Class="Aurea.Views.TableInsertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insérer un tableau" 
        Height="200" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#2A2A3E"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nombre de lignes :" 
                  Foreground="White" 
                  Grid.Row="0"
                  Margin="0,0,0,5"/>
        <TextBox x:Name="RowsTextBox" 
                Grid.Row="1" 
                Margin="0,0,0,15"
                Height="30"
                Background="#3D3D5C"
                Foreground="White"
                Padding="5"/>

        <TextBlock Text="Nombre de colonnes :" 
                  Foreground="White" 
                  Grid.Row="2"
                  Margin="0,0,0,5"/>
        <TextBox x:Name="ColumnsTextBox" 
                Grid.Row="3" 
                Height="30"
                Background="#3D3D5C"
                Foreground="White"
                Padding="5"/>

        <StackPanel Grid.Row="4" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right"
                   Margin="0,20,0,0">
            <Button Content="OK" 
                   Width="80" 
                   Height="32"
                   Margin="0,0,10,0"
                   Background="#6C3FB5"
                   Foreground="White"
                   Click="OK_Click"/>
            <Button Content="Annuler" 
                   Width="80" 
                   Height="32"
                   Background="#555"
                   Foreground="White"
                   Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>