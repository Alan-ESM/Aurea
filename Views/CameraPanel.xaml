<UserControl x:Class="Aurea.Views.CameraPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A28">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Flux vidéo -->
        <Image x:Name="CameraFeed" 
               Grid.Row="0"
               Stretch="Uniform"
               Margin="10"/>

        <!-- Contrôles caméra -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="10,5">
            <!-- Bouton enregistrement -->
            <Button x:Name="RecordButton"
                    Content="🔴 Démarrer l'enregistrement"
                    Background="Red"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="10,5"
                    Margin="5"
                    Width="200"
                    Click="RecordButton_Click"/>

            <!-- Bouton désactiver caméra -->
            <Button x:Name="StopCameraButton"
                    Content="❌ Désactiver la caméra"
                    Background="DarkRed"
                    Foreground="White"
                    Padding="10,5"
                    Margin="5"
                    Width="200"
                    Click="StopCameraButton_Click"/>

            <!-- Bouton ouvrir dossier -->
            <Button x:Name="OpenFolderButton"
                    Content="📂 Ouvrir le dossier"
                    Background="DarkBlue"
                    Foreground="White"
                    Padding="10,5"
                    Margin="5"
                    Width="200"
                    Click="OpenFolderButton_Click"/>
        </StackPanel>

        <!-- Statut -->
        <StackPanel Grid.Row="2" Background="#252534">
            <StackPanel.Margin>
                <Thickness>15</Thickness>
            </StackPanel.Margin>
            <TextBlock Text="Gestes détectés :" 
                      Foreground="White" 
                      FontWeight="Bold"/>
            <TextBlock x:Name="GestureStatus" 
                      Text="Aucun" 
                      Foreground="Cyan"
                      Margin="0,5,0,0"/>
            <TextBlock x:Name="RecordingStatus" 
                      Text="" 
                      Foreground="Yellow"
                      Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>