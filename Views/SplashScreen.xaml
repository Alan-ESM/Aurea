<Window x:Class="Aurea.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurea" 
        Height="600" Width="900"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Animation des aurores boréales -->
        <Storyboard x:Key="AuroraAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Aurora1"
                           Storyboard.TargetProperty="Opacity"
                           From="0.3" To="0.8" Duration="0:0:4"
                           AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Aurora2"
                           Storyboard.TargetProperty="Opacity"
                           From="0.4" To="0.9" Duration="0:0:5"
                           AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Aurora3"
                           Storyboard.TargetProperty="Opacity"
                           From="0.2" To="0.7" Duration="0:0:6"
                           AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource AuroraAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Fond gradient sombre -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A0E27" Offset="0"/>
                <GradientStop Color="#1a1f3a" Offset="0.5"/>
                <GradientStop Color="#0f1429" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Effet aurore boréale 1 -->
        <Ellipse x:Name="Aurora1" 
                 Width="800" Height="400" 
                 Opacity="0.4"
                 VerticalAlignment="Top"
                 Margin="0,-100,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4000FF88" Offset="0"/>
                    <GradientStop Color="#2000FFAA" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Effet aurore boréale 2 -->
        <Ellipse x:Name="Aurora2" 
                 Width="600" Height="350" 
                 Opacity="0.5"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="-150,0,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4000AAFF" Offset="0"/>
                    <GradientStop Color="#2000CCFF" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Effet aurore boréale 3 -->
        <Ellipse x:Name="Aurora3" 
                 Width="700" Height="380" 
                 Opacity="0.3"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-200,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#40FF00FF" Offset="0"/>
                    <GradientStop Color="#20FF44FF" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Contenu principal -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Logo/Titre -->
            <TextBlock Text="AUREA" 
                      FontSize="72" 
                      FontWeight="Bold"
                      Foreground="#00FFCC"
                      HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00FFCC" 
                                    BlurRadius="30" 
                                    ShadowDepth="0"
                                    Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Traitement de Texte Intelligent" 
                      FontSize="18" 
                      Foreground="#88FFEE"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,40"
                      FontStyle="Italic"/>

            <!-- Barre de progression -->
            <Border Width="400" Height="6" 
                   Background="#1A2F4F" 
                   CornerRadius="3"
                   Margin="0,0,0,20">
                <Border x:Name="ProgressBar"
                       Background="#00FFCC"
                       CornerRadius="3"
                       HorizontalAlignment="Left"
                       Width="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#00FFCC" 
                                        BlurRadius="15" 
                                        ShadowDepth="0"/>
                    </Border.Effect>
                </Border>
            </Border>

            <!-- Texte de chargement -->
            <TextBlock x:Name="LoadingText"
                      Text="Initialisation..."
                      FontSize="14"
                      Foreground="#88AACC"
                      HorizontalAlignment="Center"/>

            <!-- Version -->
            <TextBlock Text="v1.0.0 - 2025" 
                      FontSize="11" 
                      Foreground="#445566"
                      HorizontalAlignment="Center"
                      Margin="0,30,0,0"/>
        </StackPanel>

        <!-- Particules d'étoiles -->
        <Canvas x:Name="StarsCanvas">
            <!-- Les étoiles seront générées dynamiquement dans le code-behind -->
        </Canvas>
    </Grid>
</Window>