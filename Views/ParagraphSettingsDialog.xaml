<Window x:Class="Aurea.Views.ParagraphSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres de paragraphe"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#2A2A3E"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Alignement :" Foreground="White" Margin="0,0,0,6"/>
        <ComboBox x:Name="AlignmentComboBox" Grid.Row="1" Margin="0,0,0,16"
                  Background="#3D3D5C" Foreground="White" Padding="6">
            <ComboBoxItem Content="Gauche" IsSelected="True"/>
            <ComboBoxItem Content="Centré"/>
            <ComboBoxItem Content="Droite"/>
            <ComboBoxItem Content="Justifié"/>
        </ComboBox>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Espacement des lignes :" Foreground="White" Margin="0,0,0,6"/>
            <TextBox x:Name="LineSpacingTextBox" Height="32"
                     Background="#3D3D5C" Foreground="White" Padding="8"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Retrait gauche :" Foreground="White" Margin="0,0,0,6"/>
                <TextBox x:Name="LeftIndentTextBox" Text="0" Height="32"
                         Background="#3D3D5C" Foreground="White" Padding="8"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Retrait droit :" Foreground="White" Margin="0,0,0,6"/>
                <TextBox x:Name="RightIndentTextBox" Text="0" Height="32"
                         Background="#3D3D5C" Foreground="White" Padding="8"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="90" Height="34" Margin="0,0,10,0"
                    Background="#6C3FB5" Foreground="White" Click="OK_Click"/>
            <Button Content="Annuler" Width="90" Height="34"
                    Background="#555" Foreground="White" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
