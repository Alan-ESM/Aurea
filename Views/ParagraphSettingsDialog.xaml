<Window x:Class="Aurea.Views.ParagraphSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres de police" 
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#2A2A3E"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Police -->
        <TextBlock Text="Police :" 
                  Foreground="White" 
                  Grid.Row="0" Grid.Column="0"
                  Margin="0,0,0,5"/>
        <ListBox x:Name="FontFamilyList" 
                Grid.Row="1" Grid.Column="0"
                Background="#3D3D5C"
                Foreground="White"
                Margin="0,0,10,0"/>

        <!-- Taille -->
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <TextBlock Text="Taille :" 
                      Foreground="White" 
                      Margin="0,0,0,5"/>
            <ListBox x:Name="FontSizeList" 
                    Background="#3D3D5C"
                    Foreground="White"
                    Height="200"/>
        </StackPanel>

        <!-- Style -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                   Orientation="Horizontal"
                   Margin="0,15,0,15">
            <CheckBox x:Name="BoldCheckBox" 
                       Content="Gras" 
                       Foreground="White"
                       Margin="0,0,20,0"/>
            <CheckBox x:Name="ItalicCheckBox" 
                     Content="Italique" 
                     Foreground="White"/>
        </StackPanel>

        <!-- Boutons -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right">
            <Button Content="OK" 
                   Width="90" 
                   Height="34"
                   Margin="0,0,10,0"
                   Background="#6C3FB5"
                   Foreground="White"
                   Click="OK_Click"/>
            <Button Content="Annuler" 
                   Width="90" 
                   Height="34"
                   Background="#555"
                   Foreground="White"
                   Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>