<Window x:Class="Aurea.Views.FontSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aurea.Views"
        Title="Paramètres de police" 
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#2A2A3E"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Police -->
        <TextBlock Text="Police :" 
                  Foreground="White" 
                  Grid.Row="0" Grid.Column="0"
                  Margin="0,0,0,5"
                  FontWeight="SemiBold"/>

        <ListBox x:Name="FontFamilyList" 
                Grid.Row="1" Grid.Column="0"
                Background="#3D3D5C"
                Foreground="White"
                Margin="0,0,10,0"
                SelectionChanged="FontFamilyList_SelectionChanged"/>

        <!-- Taille -->
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <TextBlock Text="Taille :" 
                      Foreground="White" 
                      Margin="0,0,0,5"
                      FontWeight="SemiBold"/>
            <ListBox x:Name="FontSizeList" 
                    Background="#3D3D5C"
                    Foreground="White"
                    Height="200"
                    SelectionChanged="FontSizeList_SelectionChanged"/>
        </StackPanel>

        <!-- Style -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                   Orientation="Horizontal"
                   Margin="0,15,0,15"
                   HorizontalAlignment="Center">
            <CheckBox x:Name="BoldCheckBox" 
                     Content="Gras"
                     Checked="StyleCheckBox_Checked"
                     Unchecked="StyleCheckBox_Checked"/>
            <CheckBox x:Name="ItalicCheckBox" 
                     Content="Italique"
                     Checked="StyleCheckBox_Checked"
                     Unchecked="StyleCheckBox_Checked"/>
            <CheckBox x:Name="UnderlineCheckBox" 
                     Content="Souligné"
                     Checked="StyleCheckBox_Checked"
                     Unchecked="StyleCheckBox_Checked"/>
        </StackPanel>

        <!-- Aperçu -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#2D2D4D"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,15">
            <TextBlock x:Name="PreviewText"
                      Text="Aperçu de la police"
                      HorizontalAlignment="Center"
                      Foreground="White"/>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right">
            <Button x:Name="ApplyButton"
                   Content="Appliquer" 
                   Width="90" 
                   Height="34"
                   Margin="0,0,10,0"
                   Background="#6C3FB5"
                   Foreground="White"
                   Click="ApplyButton_Click"/>
            <Button x:Name="OKButton"
                   Content="OK" 
                   Width="90" 
                   Height="34"
                   Margin="0,0,10,0"
                   Background="#4CAF50"
                   Foreground="White"
                   Click="OKButton_Click"/>
            <Button x:Name="CancelButton"
                   Content="Annuler" 
                   Width="90" 
                   Height="34"
                   Background="#555"
                   Foreground="White"
                   Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>